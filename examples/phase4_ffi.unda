// calling C. extern blocks declare functions from a C library with their C
// types, after that they're called like any builtin. needs the native
// backend: unda run --native examples/phase4_ffi.unda

import "mem" as mem

extern "m" {
    fn sqrt(x: f64) -> f64
    fn pow(base: f64, exp: f64) -> f64
}

extern "c" {
    fn getpid() -> i32
    fn strlen(s: cstring) -> u64
    fn getenv(name: cstring) -> cstring
    fn fopen(path: cstring, mode: cstring) -> ptr
    fn fputs(s: cstring, f: ptr) -> i32
    fn fclose(f: ptr) -> i32
    fn gettimeofday(tv: ptr, tz: ptr) -> i32
}

struct Point { x: number, y: number }

fn dist(a: Point, b: Point) -> float {
    sqrt(pow(a.x - b.x, 2) + pow(a.y - b.y, 2))
}

println("distance:", dist(Point(0, 0), Point(3, 4)))
println("bytes in \"çay\":", strlen("çay"))
println("has HOME:", getenv("HOME") != nil, "pid > 0:", getpid() > 0)

// a FILE * from C is a ptr: hold it, hand it back, nothing else
let path = "/tmp/unda_ffi_example.txt"
let f = fopen(path, "w")
if f == nil {
    println("could not open", path)
} else {
    fputs("written through libc", f)
    fclose(f)
    println(read_file(path))
}

// C fills a buffer we hand it, the buffer knows its size and checks reads
let tv = mem.alloc(16)
gettimeofday(tv, nil)
println("seconds since 1970 look sane:", mem.get_i64(tv, 0) > 1700000000)
mem.free(tv)
